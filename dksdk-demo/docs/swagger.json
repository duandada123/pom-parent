{
  "swagger": "2.0",
  "info": {
    "description": "脚本创建、提交、发布与日志查询。提交和发布为异步操作，success=true 表示本次请求处理成功，最终结果请查看业务状态。",
    "version": "1.0.0",
    "title": "DataWorks SDK 接口文档"
  },
  "basePath": "/",
  "tags": [
    {
      "name": "DataWorks 脚本管理",
      "description": "Data Works Controller"
    }
  ],
  "paths": {
    "/api/dataworks/files/create": {
      "post": {
        "tags": [
          "DataWorks 脚本管理"
        ],
        "summary": "创建脚本",
        "description": "仅创建文件，返回 fileId；不会自动提交、发布或运行。",
        "operationId": "createUsingPOST",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "脚本内容及调度配置",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateScriptRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiResponse«CreateScriptResponse»"
            }
          },
          "400": {
            "description": "请求参数、日期格式或 JSON 错误"
          },
          "404": {
            "description": "未找到完全匹配的节点"
          },
          "409": {
            "description": "文件归属、发布包环境冲突或节点名称不唯一"
          },
          "422": {
            "description": "节点搜索超过分页上限"
          },
          "502": {
            "description": "DataWorks 调用失败或返回异常数据"
          },
          "503": {
            "description": "DataWorks 未配置或请求中断"
          },
          "504": {
            "description": "调用超时；写操作请先核对云端结果"
          }
        },
        "deprecated": false
      }
    },
    "/api/dataworks/files/deploy": {
      "post": {
        "tags": [
          "DataWorks 脚本管理"
        ],
        "summary": "检查状态并发布脚本",
        "description": "checkOnly=true 时只查询发布包；实际发布要求开发环境提交包 status=1、checkingStatus 为空且包含该 fileId。WAITING 表示稍后重查；PUBLISH_ACCEPTED 后使用新的 publishDeploymentId，设置 checkOnly=true 查询最终状态，不要反复发布。",
        "operationId": "deployUsingPOST",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "提交包 ID、文件 ID 或只读查询标志",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeployScriptRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiResponse«DeployScriptResponse»"
            }
          },
          "400": {
            "description": "请求参数、日期格式或 JSON 错误"
          },
          "404": {
            "description": "未找到完全匹配的节点"
          },
          "409": {
            "description": "文件归属、发布包环境冲突或节点名称不唯一"
          },
          "422": {
            "description": "节点搜索超过分页上限"
          },
          "502": {
            "description": "DataWorks 调用失败或返回异常数据"
          },
          "503": {
            "description": "DataWorks 未配置或请求中断"
          },
          "504": {
            "description": "调用超时；写操作请先核对云端结果"
          }
        },
        "deprecated": false
      }
    },
    "/api/dataworks/files/submit": {
      "post": {
        "tags": [
          "DataWorks 脚本管理"
        ],
        "summary": "提交脚本",
        "description": "返回提交包 deploymentId，SUBMIT_ACCEPTED 表示已受理，尚不代表提交完成。",
        "operationId": "submitUsingPOST",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "文件 ID 及提交说明",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SubmitScriptRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiResponse«SubmitScriptResponse»"
            }
          },
          "400": {
            "description": "请求参数、日期格式或 JSON 错误"
          },
          "404": {
            "description": "未找到完全匹配的节点"
          },
          "409": {
            "description": "文件归属、发布包环境冲突或节点名称不唯一"
          },
          "422": {
            "description": "节点搜索超过分页上限"
          },
          "502": {
            "description": "DataWorks 调用失败或返回异常数据"
          },
          "503": {
            "description": "DataWorks 未配置或请求中断"
          },
          "504": {
            "description": "调用超时；写操作请先核对云端结果"
          }
        },
        "deprecated": false
      }
    },
    "/api/dataworks/logs/query": {
      "post": {
        "tags": [
          "DataWorks 脚本管理"
        ],
        "summary": "查询运行日志",
        "description": "taskId、fileName、instanceId 三选一。按任务查询必须提供 bizdate；按实例查询可选 runNumber。按名称查询仅接受唯一精确匹配。hasMore=true 时用 nextPageNumber 续读；complete=false 表示部分日志读取失败。",
        "operationId": "logsUsingPOST",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "request",
            "description": "查询目标、业务日期及分页设置",
            "required": true,
            "schema": {
              "$ref": "#/definitions/QueryLogsRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ApiResponse«QueryLogsResponse»"
            }
          },
          "400": {
            "description": "请求参数、日期格式或 JSON 错误"
          },
          "404": {
            "description": "未找到完全匹配的节点"
          },
          "409": {
            "description": "文件归属、发布包环境冲突或节点名称不唯一"
          },
          "422": {
            "description": "节点搜索超过分页上限"
          },
          "502": {
            "description": "DataWorks 调用失败或返回异常数据"
          },
          "503": {
            "description": "DataWorks 未配置或请求中断"
          },
          "504": {
            "description": "调用超时；写操作请先核对云端结果"
          }
        },
        "deprecated": false
      }
    }
  },
