    "CreateScriptRequest": {
      "type": "object",
      "required": [
        "content",
        "fileFolderPath",
        "fileName",
        "fileType"
      ],
      "properties": {
        "autoParsing": {
          "type": "boolean",
          "example": true,
          "description": "是否由 DataWorks 自动解析代码依赖"
        },
        "autoRerunIntervalMillis": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "失败重跑间隔，毫秒，0～1800000"
        },
        "autoRerunTimes": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "执行失败自动重跑次数，0～10"
        },
        "connectionName": {
          "type": "string",
          "example": "odps_source",
          "description": "执行节点使用的数据源连接名称"
        },
        "content": {
          "type": "string",
          "example": "print('hello DataWorks')",
          "description": "脚本代码内容"
        },
        "createFolderIfNotExists": {
          "type": "boolean",
          "example": false,
          "description": "目录不存在时是否自动创建，默认 false"
        },
        "cronExpress": {
          "type": "string",
          "example": "00 30 05 * * ?",
          "description": "DataWorks 调度 cron 表达式"
        },
        "cycleType": {
          "type": "string",
          "example": "DAY",
          "description": "调度周期类型",
          "enum": [
            "DAY",
            "NOT_DAY"
          ]
        },
        "fileDescription": {
          "type": "string",
          "example": "SDK 示例脚本",
          "description": "文件描述"
        },
        "fileFolderPath": {
          "type": "string",
          "example": "业务流程/demo/MaxCompute",
          "description": "数据开发文件目录路径"
        },
        "fileName": {
          "type": "string",
          "example": "python_demo",
          "description": "文件名称；日志查询时要求唯一精确匹配"
        },
        "fileType": {
          "type": "integer",
          "format": "int32",
          "example": 1221,
          "description": "文件代码类型，按工作空间支持类型填写；1221 为参考中的 Python 示例"
        },
        "inputList": {
          "type": "string",
          "description": "节点上游输入依赖，按 DataWorks 格式填写"
        },
        "outputList": {
          "type": "string",
          "description": "节点输出依赖，按 DataWorks 格式填写"
        },
        "owner": {
          "type": "string",
          "description": "文件责任人的阿里云用户 UID"
        },
        "paraValue": {
          "type": "string",
          "example": "bizdate=$bizdate",
          "description": "调度参数，多个参数用空格分隔"
        },
        "projectId": {
          "type": "integer",
          "format": "int64",
          "example": 10000,
          "description": "DataWorks 工作空间 ID；省略时使用 DATAWORKS_PROJECT_ID"
        },
        "resourceGroupId": {
          "type": "integer",
          "format": "int64",
          "example": 12345,
          "description": "调度资源组 ID"
        },
        "resourceGroupIdentifier": {
          "type": "string",
          "description": "调度资源组标识符"
        }
      },
      "title": "CreateScriptRequest",
      "description": "创建脚本请求"
    },
    "CreateScriptResponse": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "integer",
          "format": "int64",
          "example": 1000001,
          "description": "DataWorks 文件 ID"
        },
        "requestId": {
          "type": "string",
          "example": "aliyun-request-id",
          "description": "阿里云请求追踪 ID，用于排查问题"
        }
      },
      "title": "CreateScriptResponse",
      "description": "创建脚本结果"
    },
    "DeployScriptRequest": {
      "type": "object",
      "required": [
        "deploymentId"
      ],
      "properties": {
        "checkOnly": {
          "type": "boolean",
          "example": false,
          "description": "是否只查询状态；默认 false，true 时不会执行发布"
        },
        "comment": {
          "type": "string",
          "example": "SDK 示例操作",
          "description": "本次提交或发布说明"
        },
        "deploymentId": {
          "type": "integer",
          "format": "int64",
          "example": 3000001,
          "description": "实际发布传提交包 ID；只查询时可传提交包或生产发布包 ID"
        },
        "fileId": {
          "type": "integer",
          "format": "int64",
          "example": 1000001,
          "description": "实际发布时必填；checkOnly=true 时可省略"
        },
        "projectId": {
          "type": "integer",
          "format": "int64",
          "example": 10000,
          "description": "DataWorks 工作空间 ID；省略时使用 DATAWORKS_PROJECT_ID"
        }
      },
      "title": "DeployScriptRequest",
      "description": "发布及状态查询请求"
    },
    "DeployScriptResponse": {
      "type": "object",
      "properties": {
        "checkingStatus": {
          "type": "integer",
          "format": "int32",
          "example": 8,
          "description": "发布检查状态：7 未通过，8 检查中，null 才能继续发布"
        },
        "deploymentId": {
          "type": "integer",
          "format": "int64",
          "example": 3000001,
          "description": "发布包 ID"
        },
        "fileId": {
          "type": "integer",
          "format": "int64",
          "example": 1000001,
          "description": "DataWorks 文件 ID"
        },
        "message": {
          "type": "string",
          "description": "处理结果说明"
        },
        "publishDeploymentId": {
          "type": "integer",
          "format": "int64",
          "example": 4000001,
          "description": "本次发布返回的新包 ID；用于 checkOnly=true 查询最终发布结果"
        },
        "requestId": {
          "type": "string",
          "example": "aliyun-request-id",
          "description": "阿里云请求追踪 ID，用于排查问题"
        },
        "state": {
          "type": "string",
          "example": "WAITING",
          "description": "业务处理状态",
          "enum": [
            "STATUS_ONLY",
            "WAITING",
            "SUBMIT_FAILED",
            "CHECK_FAILED",
            "PUBLISH_ACCEPTED"
          ]
        },
        "status": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "当前查询发布包状态：0 就绪，1 成功，2 失败；不是新发布包的最终状态"
        },
        "toEnvironment": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "发布包目标环境：1 开发，2 生产"
        }
      },
      "title": "DeployScriptResponse",
      "description": "发布及状态查询结果"
    },
    "InstanceLogResponse": {
      "type": "object",
      "properties": {
        "bizdate": {
          "type": "integer",
          "format": "int64",
          "example": 1792512000000,
          "description": "业务日期，毫秒时间戳"
        },
        "errorCode": {
          "type": "string",
          "description": "单条日志读取失败的错误码；成功时为 null"
        },
        "errorMessage": {
          "type": "string",
          "description": "单条日志读取失败的说明；成功时为 null"
        },
        "finishedTime": {
          "type": "integer",
          "format": "int64",
          "description": "实例结束时间，毫秒时间戳；未结束时可为 null"
        },
        "instanceId": {
          "type": "integer",
          "format": "int64",
          "example": 9000001,
          "description": "任务实例 ID"
        },
        "logContent": {
          "type": "string",
          "example": "hello DataWorks",
          "description": "实例运行日志文本；尚未产生时可能为空"
        },
        "logSuccess": {
          "type": "boolean",
          "example": true,
          "description": "该条日志是否读取成功"
        },
        "requestId": {
          "type": "string",
          "example": "aliyun-request-id",
          "description": "阿里云请求追踪 ID，用于排查问题"
        },
        "runNumber": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "实例运行次数，从 1 开始；请求时仅用于 instanceId 查询，不传取最近一次"
        },
        "startedTime": {
          "type": "integer",
          "format": "int64",
          "description": "实例开始时间，毫秒时间戳；未开始时可为 null"
        },
        "status": {
          "type": "string",
          "example": "Success",
          "description": "实例运行状态"
        },
        "taskId": {
          "type": "integer",
          "format": "int64",
          "example": 2000001,
          "description": "调度任务 ID"
        },
        "taskName": {
          "type": "string",
          "example": "python_demo",
          "description": "调度任务名称"
        }
      },
      "title": "InstanceLogResponse",
      "description": "单次实例运行日志"
    },
    "QueryLogsRequest": {
      "type": "object",
      "properties": {
        "bizdate": {
          "type": "string",
          "example": "2026-10-21",
          "description": "业务日期 yyyy-MM-dd；按任务查询必填，按实例查询可省略"
        },
        "containerId": {
          "type": "string",
          "description": "按文件名查询时的容器 ID，用于缩小范围"
        },
        "fileName": {
          "type": "string",
          "example": "python_demo",
          "description": "文件名称；日志查询时要求唯一精确匹配"
        },
        "instanceId": {
          "type": "integer",
          "format": "int64",
          "example": 9000001,
          "description": "任务实例 ID，与 taskId、fileName 三选一"
        },
        "maxPages": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "本次最多读取页数，1～5，默认 1"
        },
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "起始页码，1～1000000，默认 1"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "example": 20,
          "description": "每页实例数量，1～100，默认 20"
        },
        "projectEnv": {
          "type": "string",
          "example": "Prod",
          "description": "项目环境，默认 Prod，兼容大小写",
          "enum": [
            "Prod",
            "Dev",
            "PROD",
            "DEV"
          ]
        },
        "projectId": {
          "type": "integer",
          "format": "int64",
          "example": 10000,
          "description": "DataWorks 工作空间 ID；省略时使用 DATAWORKS_PROJECT_ID"
        },
        "runNumber": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "实例运行次数，从 1 开始；请求时仅用于 instanceId 查询，不传取最近一次"
        },
        "scene": {
          "type": "string",
          "example": "DataworksProject",
          "description": "按文件名查询时的节点场景",
          "enum": [
            "DataworksProject",
            "DataworksManualWorkflow",
            "DataworksManualTask"
          ]
        },
        "taskId": {
          "type": "integer",
          "format": "int64",
          "example": 2000001,
          "description": "调度任务 ID，与 fileName、instanceId 三选一；兼容旧名 nodeId，不能填写数据开发节点 id"
        }
      },
      "title": "QueryLogsRequest",
      "description": "日志查询请求"
    },
    "QueryLogsResponse": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean",
          "example": true,
          "description": "本次返回的日志是否全部读取成功；不表示已读完所有页"
        },
        "hasMore": {
          "type": "boolean",
          "example": true,
          "description": "是否仍有未读取的实例页"
        },
        "logs": {
          "type": "array",
          "description": "本次返回的实例日志列表",
          "items": {
            "$ref": "#/definitions/InstanceLogResponse"
          }
        },
        "nextPageNumber": {
          "type": "integer",
          "format": "int32",
          "example": 2,
          "description": "续读起始页码；没有更多数据时为 null"
        },
        "nodeId": {
          "type": "string",
          "example": "authoring-node-id",
          "description": "数据开发节点 ID（String），不是调度任务 taskId；按文件名查询时返回"
        },
        "pagesFetched": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "本次实际读取的实例页数；直接查实例时为 0"
        },
        "taskId": {
          "type": "integer",
          "format": "int64",
          "example": 2000001,
          "description": "调度任务 ID"
        },
        "totalCount": {
          "type": "integer",
          "format": "int32",
          "example": 30,
          "description": "符合条件的实例总数"
        }
      },
      "title": "QueryLogsResponse",
      "description": "日志查询结果"
    },
    "SubmitScriptRequest": {
      "type": "object",
      "required": [
        "fileId"
      ],
      "properties": {
        "comment": {
          "type": "string",
          "example": "SDK 示例操作",
          "description": "本次提交或发布说明"
        },
        "fileId": {
          "type": "integer",
          "format": "int64",
          "example": 1000001,
          "description": "DataWorks 文件 ID"
        },
        "projectId": {
          "type": "integer",
          "format": "int64",
          "example": 10000,
          "description": "DataWorks 工作空间 ID；省略时使用 DATAWORKS_PROJECT_ID"
        }
      },
      "title": "SubmitScriptRequest",
      "description": "提交脚本请求"
    },
    "SubmitScriptResponse": {
      "type": "object",
      "properties": {
        "deploymentId": {
          "type": "integer",
          "format": "int64",
          "example": 3000001,
          "description": "本次提交包 ID；使用此 ID 检查提交状态"
        },
        "fileId": {
          "type": "integer",
          "format": "int64",
          "example": 1000001,
          "description": "DataWorks 文件 ID"
        },
        "requestId": {
          "type": "string",
          "example": "aliyun-request-id",
          "description": "阿里云请求追踪 ID，用于排查问题"
        },
        "state": {
          "type": "string",
          "example": "SUBMIT_ACCEPTED",
          "description": "业务处理状态",
          "enum": [
            "SUBMIT_ACCEPTED"
          ]
        }
      },
      "title": "SubmitScriptResponse",
      "description": "提交脚本结果"
    }
  }
}
